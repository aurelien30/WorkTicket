{% extends 'base.html.twig' %}

{% block body %}
    <div class="container mt-4">
        <h1>{{ project.name }}</h1>

        <div class="row">
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header bg-secondary text-white">
                        À faire ({{ tasksAFaire|length }})
                    </div>
                    <div class="card-body">
                        {% for task in tasksAFaire %}
                            <div class="card mb-2">
                                <div class="card-body p-2">
                                    {{ task.title }}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card">
                    <div class="card-header bg-warning">
                        En cours ({{ tasksEnCours|length }})
                    </div>
                    <div class="card-body">
                        {% for task in tasksEnCours %}
                            <div class="card mb-2">
                                <div class="card-body p-2">
                                    {{ task.title }}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card">
                    <div class="card-header bg-success text-white">
                        Terminé ({{ tasksTermine|length }})
                    </div>
                    <div class="card-body">
                        {% for task in tasksTermine %}
                            <div class="card mb-2">
                                <div class="card-body p-2">
                                    {{ task.title }}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}