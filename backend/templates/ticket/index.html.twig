{% extends 'base.html.twig' %}

{% block body %}
<div class="container mt-4">
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}

    <h1 class="wt-title mb-4">Tickets</h1>

    {% for ticket in tickets %}
        <div class="wt-panel p-4 mb-4">
            <h4 class="wt-title" style="font-size: 1.2rem;">Ticket #{{ ticket.id }} — {{ ticket.title }}</h4>

            <div class="row mt-3">
                <div class="col-md-4">
                    <div class="text-muted" style="color: var(--wt-text-muted) !important;">Statut</div>
                    {% if ticket.status.name == 'IN_PROGRESS' %}
                        🟠 En cours
                    {% elseif ticket.status.name in ['NEW', 'ASSIGNED'] %}
                        🔵 Nouveau
                    {% elseif ticket.status.name == 'RESOLVED' %}
                        🟢 Résolu
                    {% else %}
                        ⚪ Fermé
                    {% endif %}
                </div>
                <div class="col-md-4">
                    <div class="text-muted" style="color: var(--wt-text-muted) !important;">Priorité</div>
                    {% if ticket.priority == 'CRITIQUE' or ticket.priority == 'HAUTE' %}
                        🔴 {{ ticket.priority|capitalize }}
                    {% elseif ticket.priority == 'MOYENNE' %}
                        🟡 {{ ticket.priority|capitalize }}
                    {% else %}
                        🟢 {{ ticket.priority|capitalize }}
                    {% endif %}
                </div>
                <div class="col-md-4">
                    <div class="text-muted" style="color: var(--wt-text-muted) !important;">Technicien</div>
                    {{ ticket.technician ? ticket.technician.prenom ~ ' ' ~ ticket.technician.nom : 'Non assigné' }}
                </div>
            </div>

            {% if is_granted('ROLE_TECHNICIEN') %}
                <div class="mt-3">
                    {% if ticket.status.name in ['NEW', 'ASSIGNED'] %}
                        <a href="{{ path('ticket_assign', {id: ticket.id}) }}" class="btn wt-btn-primary btn-sm">Prendre en charge</a>
                    {% endif %}
                    {% if ticket.status.name == 'IN_PROGRESS' %}
                        <a href="{{ path('ticket_resolve', {id: ticket.id}) }}" class="btn wt-btn-primary btn-sm">Résoudre</a>
                    {% endif %}
                    {% if ticket.status.name == 'RESOLVED' %}
                        <a href="{{ path('ticket_close', {id: ticket.id}) }}" class="btn wt-btn-primary btn-sm">Fermer</a>
                        <a href="{{ path('article_new_from_ticket', {id: ticket.id}) }}" class="btn btn-outline-light btn-sm">Créer un article</a>
                    {% endif %}
                </div>
            {% endif %}

            <hr style="border-color: rgba(46, 168, 255, 0.15);">

            <h6 class="text-muted" style="color: var(--wt-text-muted) !important;">Commentaires</h6>
            {% for comment in ticket.comments %}
                <p class="mb-1"><strong>{{ comment.author.prenom }}</strong> : {{ comment.content }}</p>
            {% endfor %}

            <form method="post" action="{{ path('ticket_comment', {id: ticket.id}) }}" enctype="multipart/form-data" class="mt-3">
                <input type="hidden" name="_token" value="{{ csrf_token('comment_' ~ ticket.id) }}">
                <div class="input-group">
                    <input type="text" name="content" class="form-control" placeholder="Écrire un message...">
                    <input type="file" name="attachment" class="form-control" accept=".jpg,.jpeg,.png,.pdf">
                    <button type="submit" class="btn wt-btn-primary">Envoyer</button>
                </div>
            </form>
        </div>
    {% endfor %}
</div>
{% endblock %}