{% extends 'base.html.twig' %}


{% block body %}
    <h1>Liste des Tickets</h1>
    <ul>
       {% for ticket in tickets %}
            <li>
               <strong>{{ ticket.title }}</strong> — {{ ticket.priority }} — {{ ticket.status.value }}

                {% if is_granted('ROLE_TECHNICIEN') %}
                    {% if ticket.status.name == 'NEW' or ticket.status.name == 'ASSIGNED' %}
                        <a href="{{ path('ticket_assign', {id: ticket.id}) }}">Prendre en charge</a>
                    {% endif %}
                    {% if ticket.status.name == 'IN_PROGRESS' %}
                        <a href="{{ path('ticket_resolve', {id: ticket.id}) }}">Résoudre</a>
                    {% endif %}
                    {% if ticket.status.name == 'RESOLVED' %}
                        <a href="{{ path('ticket_close', {id: ticket.id}) }}">Fermer</a>
                    {% endif %}
                {% endif %}

                <h4>Commentaires</h4>
                <ul>
                    {% for comment in ticket.cmments%}
                    <li>
                       <strong>{{ comment.author.prenom}} {{ comment.author.nom}}</strong>
                       {{ comment.content}}
                       <em>({{ comment.createdAt|date('d/m/Y H:i') }})</em>
                    </li>
                    {% endfor %}
                </ul>

                <form method="post" action="{{ path('ticket_comment', {id: ticket.id}) }}">
                     <input type="text name="content" placeholder="Ecrire un message..." required>
                     <button type="submit">Envoyer</button>
                </form>
            </li>
        {% endfor %}
</ul>
{% endblock %}
